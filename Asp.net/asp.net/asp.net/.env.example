# Reference only: configure these in the MonsterASP.NET control panel.
# ASP.NET Core does not load .env files automatically.
ConnectionStrings__DefaultConnection=
Jwt__Key=
Jwt__Issuer=SkillMatch.API
Jwt__Audience=SkillMatch.Web
Jwt__ExpirationMinutes=60
Cors__AllowedOrigins__0=
ResumeStorage__Directory=Storage/Resumes
Database__MigrateOnStartup=false
